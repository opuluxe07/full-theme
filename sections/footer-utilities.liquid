{% stylesheet %}
  .footer-utilities-container {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: 30px var(--padding-md);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .footer-social-icons {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
    color: #ffffff;
    align-self: flex-start;
  }

  .footer-social-icons a {
    color: #ffffff;
    transition: opacity var(--animation-values);
    width: 24px;
    height: 24px;
    display: inline-block;
  }

  .footer-social-icons a:hover {
    opacity: 0.8;
  }

  .footer-social-icons svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
    margin-bottom: 25px;
  }

  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links-col a {
    color: #808080 !important;
    font-family: var(--font-body--family) !important;
    font-size: 0.825rem !important;
    text-decoration: none !important;
    transition: color 0.3s ease !important;
    line-height: 1.4 !important;
    width: fit-content;
  }

  .footer-links-col a:hover {
    color: #cbd5e1 !important;
  }

  .footer-copyright-text {
    font-family: var(--font-body--family) !important;
    color: #808080 !important;
    font-size: 0.75rem !important;
    margin-top: 15px;
    align-self: flex-start;
  }

  @media screen and (max-width: 749px) {
    .footer-links-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 20px;
    }
  }

  @media screen and (max-width: 479px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    },
    {
      "type": "social-links"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },
        "policy_list": {
          "type": "footer-policy-list"
        },
        "social_icons": {
          "type": "social-links"
        }
      },
      "block_order": ["copyright", "policy_list", "social_icons"]
    }
  ]
}
{% endschema %}
